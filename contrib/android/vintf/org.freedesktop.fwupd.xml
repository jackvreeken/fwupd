<!-- VINTF manifest fragment declaring the fwupd binder service.

     The AIDL interface is generated with vintf stability (see src/meson.build),
     so the daemon registers a VINTF-stable binder. servicemanager refuses to
     register or resolve any VINTF-stable instance that is not declared in the
     aggregated VINTF manifest, failing with:

       Could not find org.freedesktop.fwupd.IFwupd/default in the VINTF manifest

     servicemanager reads this from both the device (/vendor) and framework
     (/system) manifests. The emulator CI test installs it under
     /system/etc/vintf/manifest/ because the emulator is started with
     -writable-system, which makes /system (not /vendor) writable
     (see contrib/ci/ubuntu-android-emulator-test.sh). -->
<manifest version="1.0" type="framework">
  <hal format="aidl">
    <name>org.freedesktop.fwupd</name>
    <version>1</version>
    <fqname>IFwupd/default</fqname>
  </hal>
</manifest>
